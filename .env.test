NODE_ENV=development
PORT=9999
LOG_LEVEL=debug
DATABASE_URL=postgresql://postgres:XXXX@localhost:5432/dev_db

# JWT secret / JWT 密钥
# Run in terminal: openssl rand -base64 32 / 终端执行: openssl rand -base64 32 生成密钥
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie settings / Cookie 设置
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=strict
# COOKIE_MAX_AGE=604800

# Redis settings / Redis 设置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# LDAP settings / LDAP 设置
LDAP_URL=ldap://localhost:389
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=ou=example,dc=example,dc=com
LDAP_USERNAME_ATTRIBUTE=sAMAccountName
LDAP_DOMAIN=

# Encryption settings / 加密设置
ENCRYPTION_KEY=