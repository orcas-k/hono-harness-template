{
  "name": "hono-harness-template",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "cross-env NODE_ENV=test vitest",
    "db:generate": "pnpm run build && drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "pnpm run build && tsx src/db/seed.ts",
    "db:studio": "pnpm run build && drizzle-kit studio",
    "crypto": "pnpm run build && node dist/src/lib/crypto-cli.js",
    "argon2": "pnpm run build && node dist/src/lib/argon2-cli.js"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.28.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.8",
    "hono-pino": "^0.10.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "ldapts": "^9.2.0",
    "node-argon2": "^1.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^11.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "1.0.0-rc.4",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
